# URL pública del backend en Render (con /api al final)
VITE_API_URL="https://api.tudominio.pe/api"
# Monitoreo de errores (opcional)
VITE_SENTRY_DSN=""
# Dominio raíz para subdominios por colegio (santaelena.kipuxedu.com → ingreso del colegio "santaelena").
# Vacío = cada colegio entra por /c/<código>.
VITE_ROOT_DOMAIN=""
# Cloudflare Turnstile para Admisión y Libro de Reclamaciones (vacío = sin CAPTCHA).
# Debe ir junto con TURNSTILE_SECRET_KEY en el backend.
VITE_TURNSTILE_SITE_KEY=""

# Correo de soporte que ve la Dirección en Ajustes → Plan (vacío = no se muestra el botón).
VITE_SUPPORT_EMAIL=""
