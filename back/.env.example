# ============================================================================
# BASE DE DATOS
# ============================================================================
DATABASE_URL="postgresql://usuario:password@host:5432/saaschool?sslmode=require"

# ============================================================================
# SEGURIDAD (genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# ============================================================================
JWT_SECRET="CAMBIAR_minimo_32_caracteres_aleatorios"
JWT_EXPIRES_IN="12h"
FILES_SIGNING_SECRET="CAMBIAR_minimo_32_caracteres_aleatorios"
BCRYPT_ROUNDS=12

# ============================================================================
# SERVIDOR
# ============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000"

# ============================================================================
# CLOUDFLARE R2: archivos subidos y respaldos de la BD.
# En desarrollo, si se dejan vacías, los archivos se guardan en back/storage-local.
# ============================================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Solo si el bucket tiene jurisdicción (UE): https://<cuenta>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=""

# Imágenes que el servidor optimiza a la vez (las demás esperan su turno).
# Sin valor: según los núcleos, máximo 2 (seguro para Render Starter, 512 MB).
# Súbelo al pasar a un plan mayor, p. ej. 4 en Standard (2 GB) u 8 en Pro (4 GB).
# IMAGE_CONCURRENCY=""

# ============================================================================
# CORREO (Nodemailer SMTP)
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
# Brevo: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_SECURE=false
# ============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="KIPUX <notificaciones@tudominio.pe>"

# ============================================================================
# WEB PUSH (genera con: npx web-push generate-vapid-keys)
# ============================================================================
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@tudominio.pe"

# ============================================================================
# MONITOREO (opcional)
# ============================================================================
SENTRY_DSN=""

# ============================================================================
# AUTOMATIZACIONES (recordatorios, resúmenes semanales, alertas)
# ============================================================================
# Sin valor: activas solo con NODE_ENV=production. "true" las fuerza en desarrollo
# (¡enviará correos y push reales!); "false" las apaga.
# AUTOMATIONS_ENABLED=true
# Tope diario de correos automáticos (Gmail personal ≈ 500 destinatarios/día)
MAIL_DAILY_LIMIT=400
# URL pública del frontend para los enlaces de los correos (por defecto, el primer CORS_ORIGINS)
# FRONTEND_URL=https://app.tudominio.pe
