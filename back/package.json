{
  "name": "saas-school-backend",
  "version": "1.0.0",
  "description": "Backend Multi-Tenant SaaS para gestión escolar",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "render-build": "prisma generate && prisma migrate deploy && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "flag:dni-passwords": "ts-node --transpile-only scripts/flag-dni-passwords.ts",
    "drive:migrate-private": "ts-node --transpile-only scripts/migrate-drive-files-to-private.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "db:backup": "ts-node --transpile-only scripts/backup-db.ts",
    "drive:check": "ts-node --transpile-only scripts/check-drive.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^186.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
