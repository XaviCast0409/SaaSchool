// ============================================================================
// 1. CONFIGURACIÓN DEL CLIENTE Y BD
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 2. ENUMERADORES (Catálogos y Tipos MINEDU/SIAGIE)
// ============================================================================
enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ADMINISTRATIVE
  TEACHER
  PARENT
}

enum DocumentType {
  DNI
  CE
  CARNET_EXTRANJERIA
  PASSPORT
  PNA // Partida de Nacimiento
  CODIGO_TEMPORAL
  PTP
  BIRTH_CERTIFICATE
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum EducationLevel {
  INITIAL
  PRIMARY
  SECONDARY
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum EnrollmentState {
  REGISTERED
  TRANSFERRED
  WITHDRAWN
}

enum RelationshipType {
  MOTHER
  FATHER
  GRANDPARENT
  UNCLE_AUNT
  TUTOR_LEGAL
  OTHER
}

enum EnrollmentCondition {
  INGRESANTE
  CONTINUO
  TRASLADO
  REENTRANTE
}

enum ObligationStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
}

enum AttendanceStatus {
  PRESENT
  ABSENT_JUSTIFIED
  ABSENT_UNJUSTIFIED
  LATE_JUSTIFIED
  LATE_UNJUSTIFIED
}

enum AttendanceOrigin {
  MANUAL
  QR_SCAN
  BARCODE
  AUTO_CLOSE
}

enum AssessmentType {
  FORMATIVE
  SUMMATIVE
}

enum CourseKind {
  OFFICIAL   // Área oficial CNEB completa
  SUBCOURSE  // Curso interno que tributa a un área oficial (Álgebra -> Matemática)
  WORKSHOP   // Taller propio: no va al SIAGIE
}

enum PeriodState {
  OPEN
  REVIEW
  CLOSED
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}


enum SubscriptionPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum NotificationType {
  PAYMENT
  ATTENDANCE
  ANNOUNCEMENT
  ACADEMIC
  INCIDENT
  GENERAL
}

// ============================================================================
// 3. CORE & TENANCY (El Colegio y los Usuarios)
// ============================================================================
model School {
  id              String           @id @default(uuid())
  modularCode     String?          @unique // Código Modular MINEDU
  localCode       String?          @unique // Código de Local MINEDU
  name            String
  documentId      String           @unique // RUC
  email           String?
  phone           String?
  address         String?
  logoUrl         String?          // URL pública del logo cargado en Cloudinary
  department      String?          // Ej: LIMA
  province        String?
  district        String?
  plan            SubscriptionPlan @default(BASIC) // Plan contratado (BASIC, PRO, ENTERPRISE)
  planExpiresAt   DateTime?        // Fecha límite de vigencia del plan
  offeredLevels   EducationLevel[] @default([PRIMARY, SECONDARY]) // Niveles que opera el colegio
  blockCertificatesOnOverdue Boolean @default(false) @map("blockGradesOnOverdue") // Retención SOLO de constancias/certificados por deuda vencida (Ley 27665)
  brandColor                 String? // Color primario de marca del colegio en HEX (#RRGGBB)
  notifyAbsencesToFamilies   Boolean   @default(true) // Avisar a las familias cuando el alumno no registra ingreso
  absenceAlertConsecutive    Int       @default(3)    // Faltas injustificadas seguidas para alerta temprana
  absenceAlertMonthlyPercent Int       @default(10)   // % de faltas injustificadas en los últimos 30 días
  lateAlertMonthlyCount      Int       @default(5)    // Tardanzas injustificadas en los últimos 30 días
  lastRiskEvaluationOn       DateTime? @db.Date
  receiptCounter       Int             @default(0)     // Correlativo oficial de recibos (REC-XXXXXX)
  isActive             Boolean         @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relaciones Multi-Tenant
  users               User[]
  students            Student[]
  academicYears       AcademicYear[]
  classrooms          Classroom[]
  areas               CurricularArea[]
  gradingScales       GradingScale[]
  obligations         PaymentObligation[]
  transactions        PaymentTransaction[]
  attendances         Attendance[]
  courseAssignments   CourseAssignment[]
  announcements       Announcement[]
  evaluationCriteria  EvaluationCriterion[]
  detailedGrades      DetailedGrade[]
  competenceConclusions CompetenceConclusion[]
  gradingPeriodLocks  GradingPeriodLock[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  courseContents      CourseContent[]
  forumComments       ForumComment[]
  attendanceScheduleConfigs AttendanceScheduleConfig[]
  incidents           StudentIncident[]
  storedFiles         StoredFile[]
  auditLogs           AuditLog[]
  legalAcceptances    LegalAcceptance[]
  holidays            SchoolHoliday[]
  attendanceJustifications AttendanceJustification[]
  attendanceAlerts         AttendanceAlert[]
  authorizedPickups        AuthorizedPickup[]
  courseAttendanceSessions CourseAttendanceSession[]
  studyPlanCourses         StudyPlanCourse[]
  competencePeriodResults  CompetencePeriodResult[]
  academicPeriodStatuses   AcademicPeriodStatus[]
}

model User {
  id               String       @id @default(uuid())
  schoolId         String
  email            String?      @unique
  passwordHash     String
  role             Role         @default(PARENT)
  
  // Requisitos SIAGIE: Nombres y Apellidos separados
  firstName        String
  lastNamePaternal String
  lastNameMaternal String
  
  documentType     DocumentType @default(DNI)
  documentId       String?
  cellphone        String?
  educationLevel   String?      // Grado de instrucción MINEDU/SIAGIE
  isActive         Boolean      @default(true)
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  school           School       @relation(fields: [schoolId], references: [id])
  
  // Relaciones
  familyRelations  FamilyRelationship[]
  coursesTaught    CourseAssignment[]
  tutoredClassrooms Classroom[] @relation("ClassroomTutor")
  announcements    Announcement[]
  lockedGradingPeriods GradingPeriodLock[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  authoredContents CourseContent[]      @relation("AuthoredContents")
  forumComments    ForumComment[]
  incidentsAuthored StudentIncident[]   @relation("IncidentAuthor")
  periodStatusChanges AcademicPeriodStatus[] @relation("PeriodStatusChangedBy")

  @@index([schoolId, role])
  @@unique([schoolId, documentId])
}

// ============================================================================
// 4. DEMOGRAFÍA Y FAMILIA (Datos MINEDU)
// ============================================================================
model Student {
  id                 String       @id @default(uuid())
  schoolId           String
  studentCode        String?      @unique // Código de Estudiante SIAGIE (14 dígitos)
  
  // Requisitos SIAGIE
  firstNames         String
  lastNamePaternal   String
  lastNameMaternal   String?
  documentType       DocumentType @default(DNI)
  documentId         String
  gender             Gender
  birthDate          DateTime
  birthCountry       String       @default("PERÚ")
  birthUbigeo        String?      // Código INEI 6 dígitos (ej: 150101)
  birthDepartment    String?
  birthProvince      String?
  birthDistrict      String?
  residenceUbigeo    String?      // Código INEI 6 dígitos actual
  motherTongue       String       @default("CASTELLANO")
  hasDisability      Boolean      @default(false)
  disabilityType     String?
  address            String?
  passwordHash       String?
  mustChangePassword Boolean      @default(true)
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  school             School       @relation(fields: [schoolId], references: [id])
  familyRelations    FamilyRelationship[]
  enrollments        Enrollment[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  authorizedPickups  AuthorizedPickup[]

  @@unique([schoolId, documentType, documentId])
  @@index([schoolId, documentId])
  @@index([schoolId, studentCode])
}

model FamilyRelationship {
  id                     String           @id @default(uuid())
  studentId              String
  userId                 String
  relationshipType       RelationshipType
  isLegalGuardian        Boolean          @default(false) // Apoderado oficial
  isFinancialResponsible Boolean          @default(false) // Quien paga (boletas)
  livesWithStudent       Boolean          @default(true)

  student                Student          @relation(fields: [studentId], references: [id])
  user                   User             @relation(fields: [userId], references: [id]) // El Parent
  
  @@unique([studentId, userId])
}

// ============================================================================
// 5. MATRÍCULA Y ESTRUCTURA ESCOLAR
// ============================================================================
model AcademicYear {
  id          String       @id @default(uuid())
  schoolId    String
  year        Int          // Ej: 2026
  name        String?      // Ej: "Año Escolar 2026"
  periodType            String       @default("BIMESTER") // BIMESTER (4 periodos) o TRIMESTER (3 periodos)
  periodsConfig         Json?        // Array<{ periodNumber: number, name: string, startDate: string, endDate: string }>
  annualCalculationMode String       @default("LAST_PERIOD") // 'LAST_PERIOD' (RVM 094-2020) o 'AVERAGE'
  promotionRulesConfig  Json?        // Overrides de reglas de situación final por nivel (ver promotion-rules.ts)
  startDate             DateTime
  endDate               DateTime
  isActive    Boolean      @default(true)

  school      School       @relation(fields: [schoolId], references: [id])
  enrollments Enrollment[]
  studyPlanCourses StudyPlanCourse[]
  courseAssignments CourseAssignment[]
  periodStatuses AcademicPeriodStatus[]
}

model Classroom {
  id             String         @id @default(uuid())
  schoolId       String
  educationLevel EducationLevel
  grade          Int            // Ej: 1, 2, 3
  section        String         // Ej: "A", "B", "Única"
  shift          Shift          @default(MORNING)
  capacity       Int            @default(30)
  tutorTeacherId String?        // Docente asignado como tutor del aula (Opcional)

  school         School         @relation(fields: [schoolId], references: [id])
  tutorTeacher   User?          @relation("ClassroomTutor", fields: [tutorTeacherId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  assignments    CourseAssignment[]
  announcements  Announcement[]
  gradingPeriodLocks GradingPeriodLock[]
  periodStatuses AcademicPeriodStatus[]

  @@index([schoolId, educationLevel, grade])
  @@index([schoolId, tutorTeacherId])
}

model Enrollment {
  id                        String          @id @default(uuid())
  schoolId                  String
  studentId                 String
  academicYearId            String
  classroomId               String
  enrollmentDate            DateTime            @default(now())
  enrollmentState           EnrollmentState     @default(REGISTERED)
  condition                 EnrollmentCondition @default(CONTINUO)
  previousSchoolModularCode String?
  repeatingGrade            Boolean             @default(false)
  customPensionAmount       Decimal?            @db.Decimal(10, 2)
  discountReason            String?
  finalSituation            String?             // PROMOTED, RECOVERY, RETAINED, TRANSFERRED, WITHDRAWN
  isActive                  Boolean             @default(true)

  student                   Student         @relation(fields: [studentId], references: [id])
  academicYear              AcademicYear    @relation(fields: [academicYearId], references: [id])
  classroom                 Classroom       @relation(fields: [classroomId], references: [id])
  
  obligations               PaymentObligation[]
  attendances               Attendance[]
  grades                    Grade[]
  detailedGrades            DetailedGrade[]
  competenceConclusions     CompetenceConclusion[]
  homeworkSubmissions       HomeworkSubmission[]
  incidents                 StudentIncident[]
  attendanceJustifications  AttendanceJustification[]
  attendanceAlerts          AttendanceAlert[]
  courseAttendanceRecords   CourseAttendanceRecord[]
  competencePeriodResults   CompetencePeriodResult[]

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, classroomId])
}

// ============================================================================
// 6. FINANZAS Y COBRANZAS (MVP Fase 1)
// ============================================================================
model PaymentObligation {
  id           String           @id @default(uuid())
  schoolId     String
  enrollmentId String
  title        String           // Ej: "Pensión Marzo 2026"
  concept      String           // Ej: "PENSION", "MATRICULA"
  amountDue    Decimal          @db.Decimal(10, 2)
  dueDate      DateTime
  status       ObligationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  school       School           @relation(fields: [schoolId], references: [id])
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  transactions PaymentTransaction[]

  @@index([schoolId, status])
  @@index([schoolId, dueDate])
}

model PaymentTransaction {
  id               String        @id @default(uuid())
  schoolId         String
  obligationId     String
  amountPaid       Decimal       @db.Decimal(10, 2)
  paymentDate      DateTime      @default(now())
  paymentMethod    PaymentMethod
  operationNumber  String?
  receiptType      String?       @default("RECIBO_INTERNO") // Solo RECIBO_INTERNO hasta integrar facturación electrónica
  receiptNumber    String?
  notes            String?

  school           School            @relation(fields: [schoolId], references: [id])
  obligation       PaymentObligation @relation(fields: [obligationId], references: [id])

  @@index([schoolId, paymentDate])
}

// ============================================================================
// 7. ACADÉMICO, SIAGIE Y CONVERSIÓN DE NOTAS (MVP Fase 2)
// ============================================================================
model CurricularArea {
  id               String                 @id @default(uuid())
  schoolId         String
  name             String                 // Ej: "Matemática"
  officialCode     String?                // Código MINEDU
  isTransversal    Boolean                @default(false)
  officialAreaCode String?                // Ej: 'MAT', 'COM', 'CYT', 'TRANS'
  parentAreaId           String?                // ID del Área Madre Oficial SIAGIE (si es una sub-área interna)
  evaluatedCompetenceIds String[]               @default([]) // Competencias evaluadas por el sub-curso
  educationLevel   EducationLevel?
  kind             CourseKind      @default(OFFICIAL)
  isActive               Boolean                @default(true)

  school                 School                 @relation(fields: [schoolId], references: [id])
  parentArea             CurricularArea?        @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: SetNull)
  subAreas               CurricularArea[]       @relation("AreaHierarchy")
  competences            CurricularCompetence[]
  assignments            CourseAssignment[]
  studyPlanCourses       StudyPlanCourse[]

  @@index([schoolId, parentAreaId])
  @@index([schoolId, educationLevel])
}

model CurricularCompetence {
  id                     String                 @id @default(uuid())
  areaId                 String
  name                   String                 // Ej: "Resuelve problemas de cantidad"
  description            String?
  officialCompetenceCode String?                // Ej: 'C1', 'C2', 'C28', 'C29'
  cnebNumber             Int?                   // Número oficial CNEB (1..31). Null solo en talleres.
  weight                 Float                  @default(1) // Peso al combinar sub-cursos en el área oficial
  isActive               Boolean                @default(true)

  area                   CurricularArea         @relation(fields: [areaId], references: [id])
  grades                 Grade[]
  detailedGrades         DetailedGrade[]
  conclusions            CompetenceConclusion[]
  periodResults          CompetencePeriodResult[]

  @@unique([areaId, cnebNumber])
}

model CourseAssignment {
  id             String    @id @default(uuid())
  schoolId       String
  academicYearId String?   // Requerido en la migración academico_restricciones (bloque 21)
  classroomId    String
  areaId         String
  teacherId      String
  deletedAt      DateTime? // Borrado lógico: nunca se borra una asignación con notas
  createdAt      DateTime  @default(now())

  school         School         @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear?  @relation(fields: [academicYearId], references: [id])
  classroom      Classroom      @relation(fields: [classroomId], references: [id])
  area           CurricularArea @relation(fields: [areaId], references: [id])
  teacher        User           @relation(fields: [teacherId], references: [id])

  gradeEntries             GradeEntry[]
  detailedGrades           DetailedGrade[]
  competenceConclusions    CompetenceConclusion[]
  contents                 CourseContent[]
  courseAttendanceSessions CourseAttendanceSession[]
  criteria                 CourseAssignmentCriterion[]
  periodResults            CompetencePeriodResult[]

  @@unique([academicYearId, classroomId, areaId])
  @@index([schoolId, teacherId])
  @@index([schoolId, academicYearId])
}

model GradeEntry {
  id                  String         @id @default(uuid())
  courseAssignmentId  String
  periodNumber        Int            // Ej: 1 para el primer bimestre
  assessmentType      AssessmentType @default(FORMATIVE)
  title               String         // "Práctica Calificada 1"
  weight              Float          @default(1.0) 
  maxScore            Float          @default(20.0) 
  dateCreated         DateTime       @default(now())

  assignment          CourseAssignment @relation(fields: [courseAssignmentId], references: [id])
  grades              Grade[]
}

model Grade {
  id                  String   @id @default(uuid())
  gradeEntryId        String
  enrollmentId        String
  competenceId        String
  
  numericScore        Float    // EL DATO BRUTO. Ej: 15.5
  teacherComment      String?  // Útil para cuando sacan C

  entry               GradeEntry           @relation(fields: [gradeEntryId], references: [id])
  enrollment          Enrollment           @relation(fields: [enrollmentId], references: [id])
  competence          CurricularCompetence @relation(fields: [competenceId], references: [id])

  @@unique([gradeEntryId, enrollmentId]) 
}

model GradingScale {
  id             String         @id @default(uuid())
  schoolId       String
  level          EducationLevel 
  letterGrade    String         // "AD", "A", "B", "C"
  minNumeric     Float          // 17.5
  maxNumeric     Float          // 20.0
  description    String?

  school         School         @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, level, letterGrade])
}

model EvaluationCriterion {
  id             String          @id @default(uuid())
  schoolId       String
  name           String          // Ej: "Práctica Calificada", "Conducta", "Revisión de Cuaderno", "Examen Bimestral"
  shortName      String          // Ej: "PC", "COND", "RC", "EB"
  weight         Float           @default(1.0)
  order          Int             @default(1)
  educationLevel EducationLevel? // Opcional: si aplica solo a INICIAL, PRIMARIA o SECUNDARIA
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  detailedGrades DetailedGrade[]
  assignmentLinks CourseAssignmentCriterion[]

  @@index([schoolId, isActive])
  @@index([schoolId, order])
}

model DetailedGrade {
  id                 String               @id @default(uuid())
  schoolId           String
  enrollmentId       String
  courseAssignmentId String
  competenceId       String
  criterionId        String
  periodNumber       Int                  // 1, 2, 3, 4 (Bimestres)
  numericScore       Float?               // 0.0 - 20.0
  literalScore       String?              // 'AD', 'A', 'B', 'C', 'EXO', '-'
  isExonerated       Boolean              @default(false)
  comment            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment         Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assignment         CourseAssignment     @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  competence         CurricularCompetence @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  criterion          EvaluationCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, courseAssignmentId, competenceId, criterionId, periodNumber])
  @@index([schoolId, courseAssignmentId, periodNumber])
  @@index([enrollmentId, periodNumber])
}

model CompetenceConclusion {
  id                 String               @id @default(uuid())
  schoolId           String
  enrollmentId       String
  courseAssignmentId String
  competenceId       String
  periodNumber       Int                  // 1, 2, 3, 4 (Bimestres)
  conclusion         String               @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment         Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assignment         CourseAssignment     @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  competence         CurricularCompetence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, courseAssignmentId, competenceId, periodNumber])
  @@index([schoolId, courseAssignmentId, periodNumber])
  @@index([enrollmentId, periodNumber])
}

model StudyPlanCourse {
  id             String         @id @default(uuid())
  schoolId       String
  academicYearId String
  educationLevel EducationLevel
  grade          Int
  areaId         String
  weeklyHours    Int?
  order          Int            @default(0)
  createdAt      DateTime       @default(now())

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  area           CurricularArea @relation(fields: [areaId], references: [id])

  @@unique([academicYearId, educationLevel, grade, areaId])
  @@index([schoolId, academicYearId])
}

model CourseAssignmentCriterion {
  id                 String              @id @default(uuid())
  courseAssignmentId String
  criterionId        String
  weight             Float?              // Si es null se usa el peso del criterio

  assignment         CourseAssignment    @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  criterion          EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([courseAssignmentId, criterionId])
}

model CompetencePeriodResult {
  id                 String               @id @default(uuid())
  schoolId           String
  enrollmentId       String
  courseAssignmentId String
  competenceId       String
  periodNumber       Int
  computedScore      Float?               // Promedio ponderado de criterios (0-20)
  suggestedLetter    String?              // AD | A | B | C | EXO
  finalLetter        String?              // Lo que se publica (nota de juicio del docente)
  isOverridden       Boolean              @default(false)
  overriddenById     String?
  overriddenAt       DateTime?
  updatedAt          DateTime             @updatedAt

  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment         Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assignment         CourseAssignment     @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  competence         CurricularCompetence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, courseAssignmentId, competenceId, periodNumber])
  @@index([schoolId, courseAssignmentId, periodNumber])
  @@index([enrollmentId, periodNumber])
}

model AcademicPeriodStatus {
  id              String       @id @default(uuid())
  schoolId        String
  academicYearId  String
  classroomId     String?      // null = todo el colegio
  periodNumber    Int
  status          PeriodState  @default(OPEN)
  gradingDeadline DateTime?
  reason          String?
  changedById     String?
  changedAt       DateTime     @default(now())

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroom       Classroom?   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  changedBy       User?        @relation("PeriodStatusChangedBy", fields: [changedById], references: [id])

  @@unique([academicYearId, classroomId, periodNumber])
  @@index([schoolId, academicYearId])
}

// ============================================================================
// 8. ASISTENCIA
// ============================================================================
model Attendance {
  id           String           @id @default(uuid())
  schoolId     String
  enrollmentId String
  date         DateTime         @default(now()) @db.Date
  status       AttendanceStatus @default(PRESENT)
  checkInTime  DateTime?
  origin       AttendanceOrigin @default(MANUAL)
  notes        String?
  checkOutTime       DateTime?
  checkOutById       String?
  pickupPersonId     String?   // AuthorizedPickup.id o User.id del apoderado que recogió
  pickedUpByName     String?
  pickedUpByDocument String?
  earlyLeaveReason   String?

  school       School           @relation(fields: [schoolId], references: [id])
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])

  @@unique([enrollmentId, date])
  @@index([schoolId, date])
}

enum AttendanceScheduleScope {
  GENERAL
  INITIAL
  PRIMARY
  SECONDARY
}

model AttendanceScheduleConfig {
  id                String                  @id @default(uuid())
  schoolId          String
  scope             AttendanceScheduleScope @default(GENERAL)
  entryTime         String                  @default("07:45")
  lateToleranceTime String                  @default("08:15")
  autoCloseTime     String                  @default("08:30")
  autoCloseEnabled  Boolean                 @default(false)
  lastAutoClosedOn  DateTime?               @db.Date
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  school            School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, scope])
  @@index([schoolId])
}

// ============================================================================
// 9. MURO DE COMUNICADOS (Fase 1)
// ============================================================================
model Announcement {
  id           String               @id @default(uuid())
  schoolId     String
  authorId     String
  classroomId  String?              // Opcional: si está dirigido a un aula específica
  title        String
  content      String
  priority     AnnouncementPriority @default(NORMAL)
  targetRoles  Role[]               // Roles que pueden ver este comunicado (TEACHER, PARENT, etc.)
  publishedAt  DateTime             @default(now())
  expiresAt    DateTime?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  school       School               @relation(fields: [schoolId], references: [id])
  author       User                 @relation(fields: [authorId], references: [id])
  classroom    Classroom?           @relation(fields: [classroomId], references: [id])

  @@index([schoolId, isActive])
}

// ============================================================================
// 10. CIERRE Y BLOQUEO DE ACTAS / PERIODOS (Auditoría Dirección)
// ============================================================================
model GradingPeriodLock {
  id           String     @id @default(uuid())
  schoolId     String
  classroomId  String?    // Si es null, aplica a todo el colegio; si tiene ID, aplica a esa aula específica
  periodNumber Int        // 1, 2, 3, 4 (Bimestres)
  isLocked     Boolean    @default(true)
  lockedAt     DateTime   @default(now())
  lockedById   String     // Usuario (Director) que ejecutó el cierre
  reason       String?    // Motivo u observación del cierre
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom    Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lockedBy     User       @relation(fields: [lockedById], references: [id])

  @@unique([schoolId, classroomId, periodNumber])
  @@index([schoolId, periodNumber])
}

// ============================================================================
// 11. NOTIFICACIONES IN-APP (Fase 1 - Web & Mobile Push)
// ============================================================================
model Notification {
  id        String           @id @default(uuid())
  schoolId  String
  userId    String?
  studentId String?
  title     String
  message   String           @db.Text
  type      NotificationType @default(GENERAL)
  link      String?          // Ruta interna de navegación (ej: /payments, /announcements)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, isRead])
  @@index([schoolId, studentId, isRead])
  @@index([schoolId, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String?
  studentId String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([schoolId, studentId])
}

// ============================================================================
// 12. AULA VIRTUAL Y CONTENIDOS ACADÉMICOS (LMS Ligero)
// ============================================================================
enum ContentType {
  LESSON_MATERIAL
  HOMEWORK
  FORUM
}

model CourseContent {
  id                 String           @id @default(uuid())
  schoolId           String
  courseAssignmentId String
  teacherId          String
  bimester           Int              // 1, 2, 3, 4
  contentType        ContentType
  title              String
  description        String           @db.Text
  fileUrl            String?
  fileName           String?
  fileType           String?
  fileSize           Int?
  dueDate            DateTime?
  publishedAt        DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseAssignment   CourseAssignment @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  teacher            User             @relation("AuthoredContents", fields: [teacherId], references: [id])
  comments           ForumComment[]
  submissions        HomeworkSubmission[]

  @@index([schoolId, courseAssignmentId, bimester])
  @@index([schoolId, contentType])
}

model ForumComment {
  id              String        @id @default(uuid())
  schoolId        String
  courseContentId String
  userId          String
  content         String        @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseContent   CourseContent @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, courseContentId, createdAt])
}

model HomeworkSubmission {
  id              String        @id @default(uuid())
  schoolId        String
  courseContentId String
  enrollmentId    String
  fileUrl         String
  fileName        String
  fileSize        Int?
  studentComment  String?
  submittedAt     DateTime      @default(now())
  isLate          Boolean       @default(false)
  numericScore    Float?
  literalScore    String?
  teacherFeedback String?
  gradedAt        DateTime?

  courseContent   CourseContent @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([courseContentId, enrollmentId])
  @@index([schoolId, courseContentId])
}

// ============================================================================
// 13. AGENDA DE INCIDENCIAS, TÓPICO Y CITACIONES
// ============================================================================
model StudentIncident {
  id                   String     @id @default(uuid())
  schoolId             String
  enrollmentId         String
  authorId             String
  type                 String     // 'MERITO' | 'DEMERITO' | 'ATENCION_TOPICO' | 'CITACION_PADRES'
  severity             String     @default("LOW") // 'LOW' | 'MEDIUM' | 'HIGH'
  title                String
  description          String     @db.Text
  actionTaken          String?    @db.Text // Ej: "Se aplicó hielo en tópico", "Se cita al apoderado"
  citationDate         DateTime?  // Fecha y hora si es CITACION_PADRES
  acknowledgedAt       DateTime?  // Fecha y hora exacta en que el padre presionó "Enterado"
  acknowledgedByUserId String?
  isViolenceCase       Boolean    @default(false) // Caso de violencia escolar (Ley 29719): debe reportarse en SíseVe
  siseveCode           String?    // Código de caso asignado por el portal SíseVe
  siseveReportedAt     DateTime?
  createdAt            DateTime   @default(now())

  school               School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment           Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  author               User       @relation("IncidentAuthor", fields: [authorId], references: [id])

  @@index([schoolId, enrollmentId])
}

// ============================================================================
// 14. ARCHIVOS PRIVADOS
// ============================================================================
enum FileStorage {
  GOOGLE_DRIVE
  LOCAL
}

model StoredFile {
  id           String      @id @default(uuid())
  schoolId     String
  uploadedById String      // userId o studentId
  uploaderRole String
  purpose      String      // COURSE_MATERIAL | HOMEWORK_SUBMISSION | OTHER
  storage      FileStorage
  driveFileId  String?     @unique
  localPath    String?
  fileName     String
  mimeType     String
  size         Int
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?

  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, uploadedById, createdAt])
}

// ============================================================================
// 15. BITÁCORA DE AUDITORÍA
// ============================================================================
model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String
  actorId    String
  actorRole  String
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, entity, entityId])
}

// ============================================================================
// 16. CONSENTIMIENTOS LEGALES (Ley 29733)
// ============================================================================
model LegalAcceptance {
  id           String   @id @default(uuid())
  schoolId     String
  userId       String?
  studentId    String?
  documentType String   // PRIVACY_POLICY | TERMS | MINOR_DATA_CONSENT
  version      String
  acceptedAt   DateTime @default(now())
  ip           String?
  userAgent    String?

  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([schoolId, studentId])
}

// ============================================================================
// 17. FERIADOS / DÍAS NO LECTIVOS
// ============================================================================
model SchoolHoliday {
  id        String   @id @default(uuid())
  schoolId  String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
}

// ============================================================================
// 18. JUSTIFICACIONES DE ASISTENCIA
// ============================================================================
enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JustificationReason {
  MEDICAL
  FAMILY
  BEREAVEMENT
  TRANSPORT
  OTHER
}

model AttendanceJustification {
  id              String              @id @default(uuid())
  schoolId        String
  enrollmentId    String
  dateFrom        DateTime            @db.Date
  dateTo          DateTime            @db.Date
  reason          JustificationReason
  description     String              @db.Text
  fileUrl         String?
  fileName        String?
  status          JustificationStatus @default(PENDING)
  requestedById   String
  requestedByRole String
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment      Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([enrollmentId, dateFrom])
}

// ============================================================================
// 19. ALERTA TEMPRANA DE AUSENTISMO
// ============================================================================
enum AttendanceAlertReason {
  CONSECUTIVE_ABSENCES
  MONTHLY_ABSENCE_RATE
  REPEATED_LATENESS
}

model AttendanceAlert {
  id           String                @id @default(uuid())
  schoolId     String
  enrollmentId String
  reason       AttendanceAlertReason
  metricValue  Float
  threshold    Float
  triggeredOn  DateTime              @db.Date
  status       String                @default("OPEN") // OPEN | ATTENDED
  attendedById String?
  attendedAt   DateTime?
  attendedNote String?
  incidentId   String?
  createdAt    DateTime              @default(now())

  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment   Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, reason, triggeredOn])
  @@index([schoolId, status])
}

// ============================================================================
// 20. PERSONAS AUTORIZADAS A RECOGER
// ============================================================================
model AuthorizedPickup {
  id           String       @id @default(uuid())
  schoolId     String
  studentId    String
  fullName     String
  documentType DocumentType @default(DNI)
  documentId   String
  relationship String       // Ej: Tía, Abuelo, Movilidad escolar
  cellphone    String?
  photoFileUrl String?      // /api/files/<id>
  isActive     Boolean      @default(true)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}

// ============================================================================
// 21. ASISTENCIA POR CURSO (registro interno del docente)
// ============================================================================
model CourseAttendanceSession {
  id                 String                   @id @default(uuid())
  schoolId           String
  courseAssignmentId String
  date               DateTime                 @db.Date
  periodLabel        String                   @default("1") // Hora pedagógica: "1".."8"
  takenById          String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseAssignment   CourseAssignment         @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  records            CourseAttendanceRecord[]

  @@unique([courseAssignmentId, date, periodLabel])
  @@index([schoolId, date])
}

model CourseAttendanceRecord {
  id           String                  @id @default(uuid())
  sessionId    String
  enrollmentId String
  status       AttendanceStatus
  note         String?

  session      CourseAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment   Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrollmentId])
}





