// ============================================================================
// 1. CONFIGURACIÓN DEL CLIENTE Y BD
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 2. ENUMERADORES (Catálogos y Tipos MINEDU/SIAGIE)
// ============================================================================
enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ADMINISTRATIVE
  TEACHER
  PARENT
}

enum DocumentType {
  DNI
  CE
  CARNET_EXTRANJERIA
  PASSPORT
  PNA // Partida de Nacimiento
  CODIGO_TEMPORAL
  PTP
  BIRTH_CERTIFICATE
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum EducationLevel {
  INITIAL
  PRIMARY
  SECONDARY
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum EnrollmentState {
  REGISTERED
  TRANSFERRED
  WITHDRAWN
}

enum RelationshipType {
  MOTHER
  FATHER
  GRANDPARENT
  UNCLE_AUNT
  TUTOR_LEGAL
  OTHER
}

enum EnrollmentCondition {
  INGRESANTE
  CONTINUO
  TRASLADO
  REENTRANTE
}

enum ObligationStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD // Tarjeta (crédito o débito)
  YAPE
  PLIN
  DEPOSIT
}

/// Estado de un registro de caja: nunca se borra, se anula con motivo.
enum FinanceRecordStatus {
  ACTIVE
  VOIDED
}

/// Rol en finanzas del personal administrativo (Dirección siempre tiene acceso total).
enum FinanceRole {
  CASHIER // Cajero: cobra y abre/cierra su caja
  TREASURER // Tesorero: anula, edita cuotas, valida vouchers y revisa cierres
  ACCOUNTANT // Contador: solo lectura
}

/// Ajuste a una cuota. LATE_FEE (mora) aumenta la deuda; los demás la reducen.
enum AdjustmentType {
  DISCOUNT // Descuento puntual (pronto pago, hermanos, etc.)
  SCHOLARSHIP // Beca aplicada desde una beca registrada
  LATE_FEE // Mora (interés moratorio)
  CREDIT_NOTE // Nota de crédito: corrección formal del monto cobrado
}

enum ScholarshipKind {
  PERCENT
  FIXED
}

enum CashSessionStatus {
  OPEN
  CLOSED
  REVIEWED
}

enum AttendanceStatus {
  PRESENT
  ABSENT_JUSTIFIED
  ABSENT_UNJUSTIFIED
  LATE_JUSTIFIED
  LATE_UNJUSTIFIED
}

enum AttendanceOrigin {
  MANUAL
  QR_SCAN
  BARCODE
  AUTO_CLOSE
}

enum CourseKind {
  OFFICIAL // Área oficial CNEB completa
  SUBCOURSE // Curso interno que tributa a un área oficial (Álgebra -> Matemática)
  WORKSHOP // Taller propio: no va al SIAGIE
}

enum PeriodState {
  OPEN
  REVIEW
  CLOSED
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum SubscriptionPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum NotificationType {
  PAYMENT
  ATTENDANCE
  ANNOUNCEMENT
  ACADEMIC
  INCIDENT
  GENERAL
  MESSAGE
}

// ============================================================================
// 3. CORE & TENANCY (El Colegio y los Usuarios)
// ============================================================================
model School {
  id                         String           @id @default(uuid())
  modularCode                String?          @unique // Código Modular MINEDU
  localCode                  String?          @unique // Código de Local MINEDU
  name                       String
  documentId                 String           @unique // RUC
  email                      String?
  phone                      String?
  address                    String?
  logoUrl                    String? // URL pública del logo cargado en Cloudinary
  department                 String? // Ej: LIMA
  province                   String?
  district                   String?
  plan                       SubscriptionPlan @default(BASIC) // Plan contratado (BASIC, PRO, ENTERPRISE)
  planExpiresAt              DateTime? // Fecha límite de vigencia del plan
  offeredLevels              EducationLevel[] @default([PRIMARY, SECONDARY]) // Niveles que opera el colegio
  blockCertificatesOnOverdue Boolean          @default(false) @map("blockGradesOnOverdue") // Retención SOLO de constancias/certificados por deuda vencida (Ley 27665)
  brandColor                 String? // Color primario de marca del colegio en HEX (#RRGGBB)
  notifyAbsencesToFamilies   Boolean          @default(true) // Avisar a las familias cuando el alumno no registra ingreso
  absenceAlertConsecutive    Int              @default(3) // Faltas injustificadas seguidas para alerta temprana
  absenceAlertMonthlyPercent Int              @default(10) // % de faltas injustificadas en los últimos 30 días
  lateAlertMonthlyCount      Int              @default(5) // Tardanzas injustificadas en los últimos 30 días
  lastRiskEvaluationOn       DateTime?        @db.Date
  messagingEnabled           Boolean          @default(true) // Mensajería familia ↔ docentes
  messagingStartTime         String           @default("07:00") // Horario de atención (hora de Lima)
  messagingEndTime           String           @default("18:00")
  whatsappCountryCode        String           @default("51") // Prefijo para enlaces de WhatsApp
  paymentQrFileUrl           String? // Imagen del QR de Yape/Plin del colegio (/api/files/<id>)
  paymentInstructions        String?          @db.Text // Números de Yape/Plin y cuentas bancarias para las familias
  receiptCounter             Int              @default(0) // Correlativo oficial de recibos (REC-XXXXXX)
  expenseCounter             Int              @default(0) // Correlativo de egresos de caja (EGR-XXXXXX)
  adjustmentCounter          Int              @default(0) // Correlativo de ajustes a cuotas (AJ-XXXXXX)
  admissionsOpen             Boolean          @default(false) // Formulario público de admisión activo
  admissionsYear             Int? // Año escolar al que postulan
  admissionsMessage          String?          @db.Text // Texto de bienvenida / requisitos
  ratificationOpen           Boolean          @default(false) // Ratificación de matrícula en línea activa
  ratificationYear           Int?
  ratificationDeadline       DateTime?        @db.Date
  complaintCounter           Int              @default(0) // Correlativo del Libro de Reclamaciones
  lateFeeAnnualRate          Decimal?         @db.Decimal(6, 3) // Tasa anual de interés moratorio (%); tope legal: interbancaria BCRP
  lateFeeGraceDays           Int              @default(0) // Días de gracia antes de cobrar mora
  isActive                   Boolean          @default(true)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  // Relaciones Multi-Tenant
  users                     User[]
  students                  Student[]
  academicYears             AcademicYear[]
  classrooms                Classroom[]
  areas                     CurricularArea[]
  gradingScales             GradingScale[]
  obligations               PaymentObligation[]
  transactions              PaymentTransaction[]
  attendances               Attendance[]
  courseAssignments         CourseAssignment[]
  announcements             Announcement[]
  evaluationCriteria        EvaluationCriterion[]
  detailedGrades            DetailedGrade[]
  competenceConclusions     CompetenceConclusion[]
  notifications             Notification[]
  pushSubscriptions         PushSubscription[]
  courseContents            CourseContent[]
  forumComments             ForumComment[]
  attendanceScheduleConfigs AttendanceScheduleConfig[]
  incidents                 StudentIncident[]
  storedFiles               StoredFile[]
  auditLogs                 AuditLog[]
  legalAcceptances          LegalAcceptance[]
  holidays                  SchoolHoliday[]
  attendanceJustifications  AttendanceJustification[]
  attendanceAlerts          AttendanceAlert[]
  tutoringInterventions     TutoringIntervention[]
  sharedResources           SharedResource[]
  rubrics                   Rubric[]
  admissionApplications     AdmissionApplication[]
  enrollmentRatifications   EnrollmentRatification[]
  documentRequests          DocumentRequest[]
  complaints                Complaint[]
  authorizedPickups         AuthorizedPickup[]
  courseAttendanceSessions  CourseAttendanceSession[]
  studyPlanCourses          StudyPlanCourse[]
  competencePeriodResults   CompetencePeriodResult[]
  studentPeriodReports      StudentPeriodReport[]
  conclusionPhrases         ConclusionPhrase[]
  hiddenConclusionPhrases   HiddenConclusionPhrase[]
  academicPeriodStatuses    AcademicPeriodStatus[]
  jobRuns                   JobRun[]
  automationSettings        SchoolAutomationSetting[]
  notificationPreferences   NotificationPreference[]
  conversations             Conversation[]
  messages                  Message[]
  announcementResponses     AnnouncementResponse[]
  meetingSlots              MeetingSlot[]
  scheduleBlocks            ScheduleBlock[]
  events                    SchoolEvent[]
  timetableTemplates        TimetableTemplate[]
  teacherAvailabilities     TeacherAvailability[]
  paymentReports            PaymentReport[]
  cashSessions              CashSession[]
  cashExpenses              CashExpense[]
  obligationAdjustments     ObligationAdjustment[]
  scholarships              Scholarship[]
}

model User {
  id           String       @id @default(uuid())
  schoolId     String
  email        String?      @unique
  passwordHash String
  role         Role         @default(PARENT)
  financeRole  FinanceRole? // Solo personal administrativo: cajero, tesorero o contador

  // Requisitos SIAGIE: Nombres y Apellidos separados
  firstName        String
  lastNamePaternal String
  lastNameMaternal String

  documentType        DocumentType @default(DNI)
  documentId          String?
  cellphone           String?
  educationLevel      String? // Grado de instrucción MINEDU/SIAGIE
  isActive            Boolean      @default(true)
  mustChangePassword  Boolean      @default(false)
  passwordChangedAt   DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  // Relaciones
  familyRelations        FamilyRelationship[]
  coursesTaught          CourseAssignment[]
  tutoredClassrooms      Classroom[]              @relation("ClassroomTutor")
  announcements          Announcement[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  authoredContents       CourseContent[]          @relation("AuthoredContents")
  forumComments          ForumComment[]
  notificationPreference NotificationPreference?
  parentConversations    Conversation[]           @relation("ConversationParent")
  staffConversations     Conversation[]           @relation("ConversationStaff")
  sentMessages           Message[]
  announcementResponses  AnnouncementResponse[]
  meetingSlotsOwned      MeetingSlot[]            @relation("MeetingStaff")
  meetingSlotsBooked     MeetingSlot[]            @relation("MeetingParent")
  createdEvents          SchoolEvent[]
  teacherAvailabilities  TeacherAvailability[]
  paymentReportsSent     PaymentReport[]          @relation("PaymentReportReporter")
  paymentReportsReviewed PaymentReport[]          @relation("PaymentReportReviewer")
  tutoringInterventions  TutoringIntervention[]
  sharedResources        SharedResource[]
  rubrics                Rubric[]
  ratificationsSigned    EnrollmentRatification[]
  documentRequestsMade   DocumentRequest[]        @relation("DocumentRequestRequester")
  documentRequestsDone   DocumentRequest[]        @relation("DocumentRequestHandler")
  complaintsAnswered     Complaint[]
  conclusionPhrases      ConclusionPhrase[]       @relation("ConclusionPhraseOwner")
  incidentsAuthored      StudentIncident[]        @relation("IncidentAuthor")
  periodStatusChanges    AcademicPeriodStatus[]   @relation("PeriodStatusChangedBy")
  paymentsCollected      PaymentTransaction[]     @relation("TransactionCollector")
  paymentsVoided         PaymentTransaction[]     @relation("TransactionVoider")
  obligationsCancelled   PaymentObligation[]      @relation("ObligationCanceller")
  cashSessions           CashSession[]            @relation("CashSessionCashier")
  cashSessionsReviewed   CashSession[]            @relation("CashSessionReviewer")
  cashExpenses           CashExpense[]            @relation("CashExpenseRegistrar")
  cashExpensesVoided     CashExpense[]            @relation("CashExpenseVoider")
  adjustmentsCreated     ObligationAdjustment[]   @relation("AdjustmentCreator")
  adjustmentsVoided      ObligationAdjustment[]   @relation("AdjustmentVoider")
  scholarshipsCreated    Scholarship[]            @relation("ScholarshipCreator")
  scholarshipsEnded      Scholarship[]            @relation("ScholarshipDeactivator")

  @@unique([schoolId, documentId])
  @@index([schoolId, role])
}

// ============================================================================
// 4. DEMOGRAFÍA Y FAMILIA (Datos MINEDU)
// ============================================================================
model Student {
  id          String  @id @default(uuid())
  schoolId    String
  studentCode String? @unique // Código de Estudiante SIAGIE (14 dígitos)

  // Requisitos SIAGIE
  firstNames          String
  lastNamePaternal    String
  lastNameMaternal    String?
  documentType        DocumentType @default(DNI)
  documentId          String
  gender              Gender
  birthDate           DateTime
  birthCountry        String       @default("PERÚ")
  birthUbigeo         String? // Código INEI 6 dígitos (ej: 150101)
  birthDepartment     String?
  birthProvince       String?
  birthDistrict       String?
  residenceUbigeo     String? // Código INEI 6 dígitos actual
  motherTongue        String       @default("CASTELLANO")
  hasDisability       Boolean      @default(false)
  disabilityType      String?
  address             String?
  passwordHash        String?
  mustChangePassword  Boolean      @default(true)
  passwordChangedAt   DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                 School                   @relation(fields: [schoolId], references: [id])
  familyRelations        FamilyRelationship[]
  enrollments            Enrollment[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  authorizedPickups      AuthorizedPickup[]
  notificationPreference NotificationPreference?
  conversations          Conversation[]
  announcementResponses  AnnouncementResponse[]
  meetingSlots           MeetingSlot[]
  admissionApplications  AdmissionApplication[]
  ratifications          EnrollmentRatification[]
  documentRequests       DocumentRequest[]

  @@unique([schoolId, documentType, documentId])
  @@index([schoolId, documentId])
  @@index([schoolId, studentCode])
}

model FamilyRelationship {
  id                     String           @id @default(uuid())
  studentId              String
  userId                 String
  relationshipType       RelationshipType
  isLegalGuardian        Boolean          @default(false) // Apoderado oficial
  isFinancialResponsible Boolean          @default(false) // Quien paga (boletas)
  livesWithStudent       Boolean          @default(true)

  student Student @relation(fields: [studentId], references: [id])
  user    User    @relation(fields: [userId], references: [id]) // El Parent

  @@unique([studentId, userId])
}

// ============================================================================
// 5. MATRÍCULA Y ESTRUCTURA ESCOLAR
// ============================================================================
model AcademicYear {
  id                    String   @id @default(uuid())
  schoolId              String
  year                  Int // Ej: 2026
  name                  String? // Ej: "Año Escolar 2026"
  periodType            String   @default("BIMESTER") // BIMESTER (4 periodos) o TRIMESTER (3 periodos)
  periodsConfig         Json? // Array<{ periodNumber: number, name: string, startDate: string, endDate: string }>
  annualCalculationMode String   @default("LAST_PERIOD") // 'LAST_PERIOD' (RVM 094-2020) o 'AVERAGE'
  promotionRulesConfig  Json? // Overrides de reglas de situación final por nivel (ver promotion-rules.ts)
  startDate             DateTime
  endDate               DateTime
  isActive              Boolean  @default(true)

  school                School                 @relation(fields: [schoolId], references: [id])
  enrollments           Enrollment[]
  studyPlanCourses      StudyPlanCourse[]
  courseAssignments     CourseAssignment[]
  scheduleBlocks        ScheduleBlock[]
  timetableTemplates    TimetableTemplate[]
  teacherAvailabilities TeacherAvailability[]
  periodStatuses        AcademicPeriodStatus[]
}

model Classroom {
  id             String         @id @default(uuid())
  schoolId       String
  educationLevel EducationLevel
  grade          Int // Ej: 1, 2, 3
  section        String // Ej: "A", "B", "Única"
  shift          Shift          @default(MORNING)
  capacity       Int            @default(30)
  tutorTeacherId String? // Docente asignado como tutor del aula (Opcional)

  school         School                 @relation(fields: [schoolId], references: [id])
  tutorTeacher   User?                  @relation("ClassroomTutor", fields: [tutorTeacherId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  assignments    CourseAssignment[]
  announcements  Announcement[]
  periodStatuses AcademicPeriodStatus[]
  scheduleBlocks ScheduleBlock[]
  events         SchoolEvent[]

  @@unique([schoolId, educationLevel, grade, section, shift])
  @@index([schoolId, educationLevel, grade])
  @@index([schoolId, tutorTeacherId])
}

model Enrollment {
  id                        String              @id @default(uuid())
  schoolId                  String
  studentId                 String
  academicYearId            String
  classroomId               String
  enrollmentDate            DateTime            @default(now())
  enrollmentState           EnrollmentState     @default(REGISTERED)
  condition                 EnrollmentCondition @default(CONTINUO)
  previousSchoolModularCode String?
  repeatingGrade            Boolean             @default(false)
  customPensionAmount       Decimal?            @db.Decimal(10, 2)
  discountReason            String?
  finalSituation            String? // PROMOTED, RECOVERY, RETAINED, TRANSFERRED, WITHDRAWN
  isActive                  Boolean             @default(true)

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  classroom    Classroom    @relation(fields: [classroomId], references: [id])

  obligations              PaymentObligation[]
  attendances              Attendance[]
  detailedGrades           DetailedGrade[]
  competenceConclusions    CompetenceConclusion[]
  homeworkSubmissions      HomeworkSubmission[]
  incidents                StudentIncident[]
  attendanceJustifications AttendanceJustification[]
  attendanceAlerts         AttendanceAlert[]
  tutoringInterventions    TutoringIntervention[]
  courseAttendanceRecords  CourseAttendanceRecord[]
  competencePeriodResults  CompetencePeriodResult[]
  periodReports            StudentPeriodReport[]
  scholarships             Scholarship[]

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, classroomId])
}

// ============================================================================
// 6. FINANZAS Y COBRANZAS (MVP Fase 1)
// ============================================================================
model PaymentObligation {
  id             String           @id @default(uuid())
  schoolId       String
  enrollmentId   String
  title          String // Ej: "Pensión Marzo 2026"
  concept        String // Ej: "PENSION", "MATRICULA"
  amountDue      Decimal          @db.Decimal(10, 2)
  /// Monto original antes de ajustes (descuentos, becas, moras). amountDue es el monto vigente.
  originalAmount Decimal?         @db.Decimal(10, 2)
  dueDate        DateTime
  status         ObligationStatus @default(PENDING)
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school         School                 @relation(fields: [schoolId], references: [id])
  enrollment     Enrollment             @relation(fields: [enrollmentId], references: [id])
  cancelledBy    User?                  @relation("ObligationCanceller", fields: [cancelledById], references: [id])
  transactions   PaymentTransaction[]
  adjustments    ObligationAdjustment[]
  paymentReports PaymentReport[]

  @@index([schoolId, status])
  @@index([schoolId, dueDate])
}

model PaymentTransaction {
  id              String              @id @default(uuid())
  schoolId        String
  obligationId    String
  amountPaid      Decimal             @db.Decimal(10, 2)
  paymentDate     DateTime            @default(now())
  paymentMethod   PaymentMethod
  operationNumber String?
  receiptType     String?             @default("RECIBO_INTERNO") // Solo RECIBO_INTERNO hasta integrar facturación electrónica
  receiptNumber   String? // Lo genera el sistema; nunca se escribe a mano
  notes           String?
  status          FinanceRecordStatus @default(ACTIVE)
  collectedById   String? // Quién cobró (cajero) o validó el voucher
  cashSessionId   String? // Caja en la que entró el cobro
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdAt       DateTime            @default(now())

  school        School            @relation(fields: [schoolId], references: [id])
  obligation    PaymentObligation @relation(fields: [obligationId], references: [id])
  collectedBy   User?             @relation("TransactionCollector", fields: [collectedById], references: [id])
  voidedBy      User?             @relation("TransactionVoider", fields: [voidedById], references: [id])
  cashSession   CashSession?      @relation(fields: [cashSessionId], references: [id])
  paymentReport PaymentReport?

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, paymentDate])
  @@index([schoolId, status, paymentDate])
  @@index([cashSessionId])
}

/// Ajuste con trazabilidad a una cuota: nunca se borra, se anula con motivo.
/// Al crearlo o anularlo se recalcula amountDue de la cuota.
model ObligationAdjustment {
  id            String              @id @default(uuid())
  schoolId      String
  obligationId  String
  number        String // AJ-000001
  type          AdjustmentType
  amount        Decimal             @db.Decimal(10, 2) // Siempre positivo; el tipo define si suma o resta
  reason        String
  scholarshipId String?
  createdById   String
  status        FinanceRecordStatus @default(ACTIVE)
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  createdAt     DateTime            @default(now())

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  obligation  PaymentObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  scholarship Scholarship?      @relation(fields: [scholarshipId], references: [id])
  createdBy   User              @relation("AdjustmentCreator", fields: [createdById], references: [id])
  voidedBy    User?             @relation("AdjustmentVoider", fields: [voidedById], references: [id])

  @@unique([schoolId, number])
  @@index([obligationId])
  @@index([schoolId, createdAt])
  @@index([scholarshipId])
}

/// Beca o descuento recurrente de una matrícula (p. ej. 50 % de la pensión de marzo a diciembre).
/// Se aplica como ajuste SCHOLARSHIP a cada cuota que cubre.
model Scholarship {
  id                 String          @id @default(uuid())
  schoolId           String
  enrollmentId       String
  name               String // Ej: "Beca hermanos", "Beca socioeconómica"
  kind               ScholarshipKind
  value              Decimal         @db.Decimal(10, 2) // % o monto fijo por cuota
  concepts           String[]        @default(["PENSION"])
  validFrom          DateTime        @db.Date
  validTo            DateTime?       @db.Date
  reason             String
  isActive           Boolean         @default(true)
  createdById        String
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivationReason String?
  createdAt          DateTime        @default(now())

  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment    Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdBy     User                   @relation("ScholarshipCreator", fields: [createdById], references: [id])
  deactivatedBy User?                  @relation("ScholarshipDeactivator", fields: [deactivatedById], references: [id])
  adjustments   ObligationAdjustment[]

  @@index([schoolId, isActive])
  @@index([enrollmentId])
}

/// Caja de un cajero: se abre con un fondo inicial y se cierra contando el efectivo.
/// Esperado = fondo + cobros en efectivo − egresos. Diferencia = contado − esperado.
model CashSession {
  id             String            @id @default(uuid())
  schoolId       String
  cashierId      String
  status         CashSessionStatus @default(OPEN)
  openedAt       DateTime          @default(now())
  openingAmount  Decimal           @db.Decimal(10, 2)
  openingNote    String?
  closedAt       DateTime?
  expectedCash   Decimal?          @db.Decimal(10, 2)
  countedCash    Decimal?          @db.Decimal(10, 2)
  difference     Decimal?          @db.Decimal(10, 2)
  totalsByMethod Json? // Foto del cierre: cobros por medio de pago, egresos y cantidades
  closingNote    String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?
  reopenCount    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cashier      User                 @relation("CashSessionCashier", fields: [cashierId], references: [id])
  reviewedBy   User?                @relation("CashSessionReviewer", fields: [reviewedById], references: [id])
  transactions PaymentTransaction[]
  expenses     CashExpense[]

  @@index([schoolId, status])
  @@index([schoolId, openedAt])
  @@index([cashierId, status])
}

/// Egreso de caja chica pagado en efectivo desde una caja abierta. Se anula, no se borra.
model CashExpense {
  id             String              @id @default(uuid())
  schoolId       String
  cashSessionId  String
  expenseNumber  String // EGR-000001
  category       String
  description    String
  amount         Decimal             @db.Decimal(10, 2)
  beneficiary    String?
  documentType   String? // BOLETA | FACTURA | RECIBO_HONORARIOS | TICKET | SIN_COMPROBANTE
  documentNumber String?
  attachmentUrl  String?
  registeredById String
  status         FinanceRecordStatus @default(ACTIVE)
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime            @default(now())

  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cashSession  CashSession @relation(fields: [cashSessionId], references: [id])
  registeredBy User        @relation("CashExpenseRegistrar", fields: [registeredById], references: [id])
  voidedBy     User?       @relation("CashExpenseVoider", fields: [voidedById], references: [id])

  @@unique([schoolId, expenseNumber])
  @@index([schoolId, createdAt])
  @@index([cashSessionId])
}

// ============================================================================
// 7. ACADÉMICO, SIAGIE Y CONVERSIÓN DE NOTAS (MVP Fase 2)
// ============================================================================
model CurricularArea {
  id               String         @id @default(uuid())
  schoolId         String
  name             String // Ej: "Matemática"
  officialCode     String? // Código MINEDU
  isTransversal    Boolean        @default(false)
  officialAreaCode String? // Ej: 'MAT', 'COM', 'CYT', 'TRANS'
  parentAreaId     String? // ID del Área Madre Oficial SIAGIE (si es una sub-área interna)
  educationLevel   EducationLevel
  kind             CourseKind     @default(OFFICIAL)
  catalogKey       String? // Curso del catálogo preuniversitario (ej: 'ALGEBRA'); null = curso propio del colegio
  isActive         Boolean        @default(true)

  school           School                 @relation(fields: [schoolId], references: [id])
  parentArea       CurricularArea?        @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: SetNull)
  subAreas         CurricularArea[]       @relation("AreaHierarchy")
  competences      CurricularCompetence[]
  assignments      CourseAssignment[]
  studyPlanCourses StudyPlanCourse[]

  @@index([schoolId, parentAreaId])
  @@index([schoolId, educationLevel])
}

model CurricularCompetence {
  id                     String  @id @default(uuid())
  areaId                 String
  name                   String // Ej: "Resuelve problemas de cantidad"
  description            String?
  officialCompetenceCode String? // Ej: 'C1', 'C2', 'C28', 'C29'
  cnebNumber             Int? // Número oficial CNEB (1..31). Null solo en talleres.
  weight                 Float   @default(1) // Peso al combinar sub-cursos en el área oficial
  isActive               Boolean @default(true)

  area           CurricularArea           @relation(fields: [areaId], references: [id])
  detailedGrades DetailedGrade[]
  conclusions    CompetenceConclusion[]
  periodResults  CompetencePeriodResult[]

  @@unique([areaId, cnebNumber])
}

model CourseAssignment {
  id             String    @id @default(uuid())
  schoolId       String
  academicYearId String
  classroomId    String
  areaId         String
  teacherId      String
  deletedAt      DateTime? // Borrado lógico: nunca se borra una asignación con notas
  createdAt      DateTime  @default(now())

  school       School         @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  classroom    Classroom      @relation(fields: [classroomId], references: [id])
  area         CurricularArea @relation(fields: [areaId], references: [id])
  teacher      User           @relation(fields: [teacherId], references: [id])

  detailedGrades           DetailedGrade[]
  competenceConclusions    CompetenceConclusion[]
  contents                 CourseContent[]
  courseAttendanceSessions CourseAttendanceSession[]
  criteria                 CourseAssignmentCriterion[]
  scheduleBlocks           ScheduleBlock[]
  periodResults            CompetencePeriodResult[]

  @@unique([academicYearId, classroomId, areaId])
  @@index([schoolId, teacherId])
  @@index([schoolId, academicYearId])
}

model GradingScale {
  id          String         @id @default(uuid())
  schoolId    String
  level       EducationLevel
  letterGrade String // "AD", "A", "B", "C"
  minNumeric  Float // 17.5
  maxNumeric  Float // 20.0
  description String?

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, level, letterGrade])
}

model EvaluationCriterion {
  id             String          @id @default(uuid())
  schoolId       String
  name           String // Ej: "Práctica Calificada", "Conducta", "Revisión de Cuaderno", "Examen Bimestral"
  shortName      String // Ej: "PC", "COND", "RC", "EB"
  weight         Float           @default(1.0)
  order          Int             @default(1)
  educationLevel EducationLevel? // Opcional: si aplica solo a INICIAL, PRIMARIA o SECUNDARIA
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  school          School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  detailedGrades  DetailedGrade[]
  assignmentLinks CourseAssignmentCriterion[]

  @@index([schoolId, isActive])
  @@index([schoolId, order])
}

model DetailedGrade {
  id                 String   @id @default(uuid())
  schoolId           String
  enrollmentId       String
  courseAssignmentId String
  competenceId       String
  criterionId        String
  periodNumber       Int // 1, 2, 3, 4 (Bimestres)
  numericScore       Float? // 0.0 - 20.0
  literalScore       String? // 'AD', 'A', 'B', 'C', 'EXO', '-'
  isExonerated       Boolean  @default(false)
  comment            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assignment CourseAssignment     @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  competence CurricularCompetence @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, courseAssignmentId, competenceId, criterionId, periodNumber])
  @@index([schoolId, courseAssignmentId, periodNumber])
  @@index([enrollmentId, periodNumber])
}

model CompetenceConclusion {
  id                 String   @id @default(uuid())
  schoolId           String
  enrollmentId       String
  courseAssignmentId String
  competenceId       String
  periodNumber       Int // 1, 2, 3, 4 (Bimestres)
  conclusion         String   @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assignment CourseAssignment     @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  competence CurricularCompetence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, courseAssignmentId, competenceId, periodNumber])
  @@index([schoolId, courseAssignmentId, periodNumber])
  @@index([enrollmentId, periodNumber])
}

model StudyPlanCourse {
  id                String         @id @default(uuid())
  schoolId          String
  academicYearId    String
  educationLevel    EducationLevel
  grade             Int
  areaId            String
  weeklyHours       Int?
  preferDoubleBlock Boolean        @default(true) // Generador de horario: agrupar en bloques de 2 horas
  maxHoursPerDay    Int            @default(2) // Generador: máximo de horas del curso en un mismo día
  preferEarly       Boolean        @default(false) // Generador: preferir las primeras horas
  order             Int            @default(0)
  createdAt         DateTime       @default(now())

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  area         CurricularArea @relation(fields: [areaId], references: [id])

  @@unique([academicYearId, educationLevel, grade, areaId])
  @@index([schoolId, academicYearId])
}

model CourseAssignmentCriterion {
  id                 String @id @default(uuid())
  courseAssignmentId String
  criterionId        String
  weight             Float? // Si es null se usa el peso del criterio

  assignment CourseAssignment    @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([courseAssignmentId, criterionId])
}

model CompetencePeriodResult {
  id                 String    @id @default(uuid())
  schoolId           String
  enrollmentId       String
  courseAssignmentId String
  competenceId       String
  periodNumber       Int
  computedScore      Float? // Promedio ponderado de criterios (0-20)
  suggestedLetter    String? // AD | A | B | C | EXO
  finalLetter        String? // Lo que se publica (nota de juicio del docente)
  isOverridden       Boolean   @default(false)
  overriddenById     String?
  overriddenAt       DateTime?
  updatedAt          DateTime  @updatedAt

  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assignment CourseAssignment     @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  competence CurricularCompetence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, courseAssignmentId, competenceId, periodNumber])
  @@index([schoolId, courseAssignmentId, periodNumber])
  @@index([enrollmentId, periodNumber])
}

/// Frases de conclusión descriptiva creadas por el colegio (ownerId null) o por un docente (ownerId).
/// Las frases de fábrica viven en código (phrase-bank.catalog.ts) y no se guardan aquí.
model ConclusionPhrase {
  id             String          @id @default(uuid())
  schoolId       String
  ownerId        String? // null = frase del colegio para todos los docentes
  educationLevel EducationLevel? // null = cualquier nivel
  cnebNumber     Int // Competencia CNEB a la que aplica
  letter         String? // AD | A | B | C ; null = cualquier nivel de logro
  courseKey      String? // Curso del catálogo preuniversitario (ej: 'ALGEBRA'); null = cualquier curso
  text           String          @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  owner  User?  @relation("ConclusionPhraseOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([schoolId, cnebNumber])
  @@index([schoolId, ownerId])
}

/// Frases de fábrica que el colegio decidió ocultar a sus docentes.
model HiddenConclusionPhrase {
  id        String   @id @default(uuid())
  schoolId  String
  phraseKey String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, phraseKey])
}

/// Libreta interna: conducta y comentario del tutor o tutora por estudiante y periodo (no va al SIAGIE).
model StudentPeriodReport {
  id             String   @id @default(uuid())
  schoolId       String
  enrollmentId   String
  periodNumber   Int
  conductScore   Float? // 0-20 (opcional si el colegio califica la conducta con letra)
  conductLetter  String? // AD | A | B | C (se deduce de la nota si no se escribe)
  conductComment String?  @db.Text
  tutorComment   String?  @db.Text // Comentario del tutor sobre el desempeño general
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, periodNumber])
  @@index([schoolId, periodNumber])
}

model AcademicPeriodStatus {
  id              String      @id @default(uuid())
  schoolId        String
  academicYearId  String
  classroomId     String? // null = todo el colegio
  periodNumber    Int
  status          PeriodState @default(OPEN)
  gradingDeadline DateTime?
  reason          String?
  changedById     String?
  changedAt       DateTime    @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroom    Classroom?   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation("PeriodStatusChangedBy", fields: [changedById], references: [id])

  @@unique([academicYearId, classroomId, periodNumber])
  @@index([schoolId, academicYearId])
}

// ============================================================================
// 8. ASISTENCIA
// ============================================================================
model Attendance {
  id                 String           @id @default(uuid())
  schoolId           String
  enrollmentId       String
  date               DateTime         @default(now()) @db.Date
  status             AttendanceStatus @default(PRESENT)
  checkInTime        DateTime?
  origin             AttendanceOrigin @default(MANUAL)
  notes              String?
  checkOutTime       DateTime?
  checkOutById       String?
  pickupPersonId     String? // AuthorizedPickup.id o User.id del apoderado que recogió
  pickedUpByName     String?
  pickedUpByDocument String?
  earlyLeaveReason   String?

  school     School     @relation(fields: [schoolId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([enrollmentId, date])
  @@index([schoolId, date])
}

enum AttendanceScheduleScope {
  GENERAL
  INITIAL
  PRIMARY
  SECONDARY
}

model AttendanceScheduleConfig {
  id                String                  @id @default(uuid())
  schoolId          String
  scope             AttendanceScheduleScope @default(GENERAL)
  entryTime         String                  @default("07:45")
  lateToleranceTime String                  @default("08:15")
  autoCloseTime     String                  @default("08:30")
  autoCloseEnabled  Boolean                 @default(false)
  lastAutoClosedOn  DateTime?               @db.Date
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, scope])
  @@index([schoolId])
}

// ============================================================================
// 9. MURO DE COMUNICADOS (Fase 1)
// ============================================================================
model Announcement {
  id               String                   @id @default(uuid())
  schoolId         String
  authorId         String
  classroomId      String? // Opcional: si está dirigido a un aula específica
  title            String
  content          String
  priority         AnnouncementPriority     @default(NORMAL)
  targetRoles      Role[] // Roles que pueden ver este comunicado (TEACHER, PARENT, etc.)
  publishedAt      DateTime                 @default(now())
  expiresAt        DateTime?
  responseType     AnnouncementResponseType @default(NONE)
  responseDeadline DateTime?
  pollOptions      String[]                 @default([])
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  school    School                 @relation(fields: [schoolId], references: [id])
  author    User                   @relation(fields: [authorId], references: [id])
  classroom Classroom?             @relation(fields: [classroomId], references: [id])
  responses AnnouncementResponse[]

  @@index([schoolId, isActive])
}

// ============================================================================
// 11. NOTIFICACIONES IN-APP (Fase 1 - Web & Mobile Push)
// ============================================================================
model Notification {
  id        String           @id @default(uuid())
  schoolId  String
  userId    String?
  studentId String?
  title     String
  message   String           @db.Text
  type      NotificationType @default(GENERAL)
  link      String? // Ruta interna de navegación (ej: /payments, /announcements)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, isRead])
  @@index([schoolId, studentId, isRead])
  @@index([schoolId, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String?
  studentId String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([schoolId, studentId])
}

// ============================================================================
// 12. AULA VIRTUAL Y CONTENIDOS ACADÉMICOS (LMS Ligero)
// ============================================================================
enum ContentType {
  LESSON_MATERIAL
  HOMEWORK
  FORUM
}

model CourseContent {
  id                 String      @id @default(uuid())
  schoolId           String
  courseAssignmentId String
  teacherId          String
  bimester           Int // 1, 2, 3, 4
  contentType        ContentType
  title              String
  description        String      @db.Text
  fileUrl            String?
  fileName           String?
  fileType           String?
  fileSize           Int?
  dueDate            DateTime?
  publishedAt        DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseAssignment CourseAssignment     @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  teacher          User                 @relation("AuthoredContents", fields: [teacherId], references: [id])
  comments         ForumComment[]
  submissions      HomeworkSubmission[]

  @@index([schoolId, courseAssignmentId, bimester])
  @@index([schoolId, contentType])
}

model ForumComment {
  id              String   @id @default(uuid())
  schoolId        String
  courseContentId String
  userId          String
  content         String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseContent CourseContent @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, courseContentId, createdAt])
}

model HomeworkSubmission {
  id              String    @id @default(uuid())
  schoolId        String
  courseContentId String
  enrollmentId    String
  fileUrl         String
  fileName        String
  fileSize        Int?
  studentComment  String?
  submittedAt     DateTime  @default(now())
  isLate          Boolean   @default(false)
  numericScore    Float?
  literalScore    String?
  teacherFeedback String?
  gradedAt        DateTime?

  courseContent CourseContent @relation(fields: [courseContentId], references: [id], onDelete: Cascade)
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([courseContentId, enrollmentId])
  @@index([schoolId, courseContentId])
}

// ============================================================================
// 13. AGENDA DE INCIDENCIAS, TÓPICO Y CITACIONES
// ============================================================================
model StudentIncident {
  id                   String    @id @default(uuid())
  schoolId             String
  enrollmentId         String
  authorId             String
  type                 String // 'MERITO' | 'DEMERITO' | 'ATENCION_TOPICO' | 'CITACION_PADRES'
  severity             String    @default("LOW") // 'LOW' | 'MEDIUM' | 'HIGH'
  title                String
  description          String    @db.Text
  actionTaken          String?   @db.Text // Ej: "Se aplicó hielo en tópico", "Se cita al apoderado"
  citationDate         DateTime? // Fecha y hora si es CITACION_PADRES
  acknowledgedAt       DateTime? // Fecha y hora exacta en que el padre presionó "Enterado"
  acknowledgedByUserId String?
  isViolenceCase       Boolean   @default(false) // Caso de violencia escolar (Ley 29719): debe reportarse en SíseVe
  siseveCode           String? // Código de caso asignado por el portal SíseVe
  siseveReportedAt     DateTime?
  createdAt            DateTime  @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  author     User       @relation("IncidentAuthor", fields: [authorId], references: [id])

  @@index([schoolId, enrollmentId])
}

// ============================================================================
// 14. ARCHIVOS PRIVADOS
// ============================================================================
enum FileStorage {
  GOOGLE_DRIVE
  LOCAL
}

model StoredFile {
  id           String      @id @default(uuid())
  schoolId     String
  uploadedById String // userId o studentId
  uploaderRole String
  purpose      String // COURSE_MATERIAL | HOMEWORK_SUBMISSION | OTHER
  storage      FileStorage
  driveFileId  String?     @unique
  localPath    String?
  fileName     String
  mimeType     String
  size         Int
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, uploadedById, createdAt])
}

// ============================================================================
// 15. BITÁCORA DE AUDITORÍA
// ============================================================================
model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String
  actorId    String
  actorRole  String
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, entity, entityId])
}

// ============================================================================
// 16. CONSENTIMIENTOS LEGALES (Ley 29733)
// ============================================================================
model LegalAcceptance {
  id           String   @id @default(uuid())
  schoolId     String
  userId       String?
  studentId    String?
  documentType String // PRIVACY_POLICY | TERMS | MINOR_DATA_CONSENT
  version      String
  acceptedAt   DateTime @default(now())
  ip           String?
  userAgent    String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([schoolId, studentId])
}

// ============================================================================
// 17. FERIADOS / DÍAS NO LECTIVOS
// ============================================================================
model SchoolHoliday {
  id        String   @id @default(uuid())
  schoolId  String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
}

// ============================================================================
// 18. JUSTIFICACIONES DE ASISTENCIA
// ============================================================================
enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JustificationReason {
  MEDICAL
  FAMILY
  BEREAVEMENT
  TRANSPORT
  OTHER
}

model AttendanceJustification {
  id              String              @id @default(uuid())
  schoolId        String
  enrollmentId    String
  dateFrom        DateTime            @db.Date
  dateTo          DateTime            @db.Date
  reason          JustificationReason
  description     String              @db.Text
  fileUrl         String?
  fileName        String?
  status          JustificationStatus @default(PENDING)
  requestedById   String
  requestedByRole String
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([enrollmentId, dateFrom])
}

// ============================================================================
// 19. ALERTA TEMPRANA DE AUSENTISMO
// ============================================================================
enum AttendanceAlertReason {
  CONSECUTIVE_ABSENCES
  MONTHLY_ABSENCE_RATE
  REPEATED_LATENESS
}

model AttendanceAlert {
  id           String                @id @default(uuid())
  schoolId     String
  enrollmentId String
  reason       AttendanceAlertReason
  metricValue  Float
  threshold    Float
  triggeredOn  DateTime              @db.Date
  status       String                @default("OPEN") // OPEN | ATTENDED
  attendedById String?
  attendedAt   DateTime?
  attendedNote String?
  incidentId   String?
  createdAt    DateTime              @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, reason, triggeredOn])
  @@index([schoolId, status])
}

// ============================================================================
// 20. PERSONAS AUTORIZADAS A RECOGER
// ============================================================================
model AuthorizedPickup {
  id           String       @id @default(uuid())
  schoolId     String
  studentId    String
  fullName     String
  documentType DocumentType @default(DNI)
  documentId   String
  relationship String // Ej: Tía, Abuelo, Movilidad escolar
  cellphone    String?
  photoFileUrl String? // /api/files/<id>
  isActive     Boolean      @default(true)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}

// ============================================================================
// 21. ASISTENCIA POR CURSO (registro interno del docente)
// ============================================================================
model CourseAttendanceSession {
  id                 String   @id @default(uuid())
  schoolId           String
  courseAssignmentId String
  date               DateTime @db.Date
  periodLabel        String   @default("1") // Hora pedagógica: "1".."8"
  takenById          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseAssignment CourseAssignment         @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  records          CourseAttendanceRecord[]

  @@unique([courseAssignmentId, date, periodLabel])
  @@index([schoolId, date])
}

model CourseAttendanceRecord {
  id           String           @id @default(uuid())
  sessionId    String
  enrollmentId String
  status       AttendanceStatus
  note         String?

  session    CourseAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrollmentId])
}

// ==========================================
// Automatizaciones (Fase 1)
// ==========================================

enum JobRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Registro de cada ejecución de un trabajo programado. La clave única
/// (jobName, schoolId, runKey) garantiza que un trabajo no se ejecute dos veces
/// y permite recuperar ejecuciones perdidas tras un reinicio del servidor.
model JobRun {
  id             String       @id @default(uuid())
  jobName        String
  schoolId       String
  runKey         String // Ej: '2026-11-15' o 'manual:1731700000000'
  status         JobRunStatus @default(RUNNING)
  itemsProcessed Int          @default(0)
  summary        String?
  error          String?      @db.Text
  triggeredById  String? // Usuario que la lanzó manualmente (null = automática)
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([jobName, schoolId, runKey])
  @@index([schoolId, jobName, startedAt])
}

/// Activación por colegio de cada automatización (si no hay fila, se usa el valor por defecto del trabajo).
model SchoolAutomationSetting {
  id          String   @id @default(uuid())
  schoolId    String
  jobName     String
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, jobName])
}

/// Preferencias de notificación de un usuario (padre, docente, personal) o de un alumno.
model NotificationPreference {
  id           String             @id @default(uuid())
  schoolId     String
  userId       String?            @unique
  studentId    String?            @unique
  mutedPush    NotificationType[] @default([])
  mutedEmail   NotificationType[] @default([])
  weeklyDigest Boolean            @default(true)
  quietFrom    String? // 'HH:mm' hora de Lima; sin push en este rango
  quietTo      String?
  updatedAt    DateTime           @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ==========================================
// Comunicación (Fase 2)
// ==========================================

enum AnnouncementResponseType {
  NONE // Solo informativo
  ACKNOWLEDGE // "Leído y enterado"
  AUTHORIZATION // Autorizo / No autorizo (paseos, salidas, vacunas)
  POLL // Encuesta de una opción
}

/// Respuesta de un apoderado a un comunicado (por hijo cuando corresponde). Guarda fecha, IP y
/// navegador como constancia, igual que LegalAcceptance.
model AnnouncementResponse {
  id             String   @id @default(uuid())
  schoolId       String
  announcementId String
  userId         String
  studentId      String?
  response       String // ACK | AUTHORIZED | NOT_AUTHORIZED | texto de la opción de encuesta
  comment        String?  @db.Text
  ipAddress      String?
  userAgent      String?
  respondedAt    DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, studentId])
  @@index([schoolId, announcementId])
}

/// Conversación privada entre un apoderado y un miembro del personal sobre un alumno.
model Conversation {
  id               String    @id @default(uuid())
  schoolId         String
  studentId        String
  parentId         String
  staffId          String
  lastMessageAt    DateTime  @default(now())
  lastMessageText  String?
  parentLastReadAt DateTime?
  staffLastReadAt  DateTime?
  createdAt        DateTime  @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent   User      @relation("ConversationParent", fields: [parentId], references: [id], onDelete: Cascade)
  staff    User      @relation("ConversationStaff", fields: [staffId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([studentId, parentId, staffId])
  @@index([schoolId, parentId, lastMessageAt])
  @@index([schoolId, staffId, lastMessageAt])
}

model Message {
  id             String   @id @default(uuid())
  schoolId       String
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum MeetingSlotStatus {
  AVAILABLE
  BOOKED
  CANCELLED
}

enum MeetingMode {
  IN_PERSON
  VIRTUAL
  PHONE
}

/// Horario de entrevista publicado por un docente o tutor, que un apoderado puede reservar.
model MeetingSlot {
  id               String            @id @default(uuid())
  schoolId         String
  staffId          String
  startsAt         DateTime
  endsAt           DateTime
  mode             MeetingMode       @default(IN_PERSON)
  location         String? // Aula, sala o enlace de videollamada
  status           MeetingSlotStatus @default(AVAILABLE)
  bookedByParentId String?
  studentId        String?
  reason           String?           @db.Text
  bookedAt         DateTime?
  createdAt        DateTime          @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff   User     @relation("MeetingStaff", fields: [staffId], references: [id], onDelete: Cascade)
  parent  User?    @relation("MeetingParent", fields: [bookedByParentId], references: [id], onDelete: SetNull)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, staffId, startsAt])
  @@index([schoolId, bookedByParentId])
}

// ==========================================
// Horario y calendario (Fase 3)
// ==========================================

/// Bloque del horario semanal de un aula. Sin courseAssignmentId es un bloque libre (recreo, tutoría, refrigerio).
model ScheduleBlock {
  id                 String   @id @default(uuid())
  schoolId           String
  academicYearId     String
  classroomId        String
  courseAssignmentId String?
  label              String? // Para bloques sin curso: "Recreo", "Refrigerio"
  dayOfWeek          Int // 1 = lunes … 6 = sábado
  startTime          String // 'HH:mm' hora de Lima
  endTime            String
  room               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroom        Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  courseAssignment CourseAssignment? @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)

  @@index([schoolId, classroomId, dayOfWeek])
  @@index([schoolId, academicYearId])
  @@index([courseAssignmentId])
}

enum SchoolEventType {
  EXAM // Evaluación
  ACTIVITY // Actuación, paseo, deporte
  MEETING // Reunión de padres
  CIVIC // Fecha cívica
  DEADLINE // Fecha límite (matrícula, entrega de documentos)
  OTHER
}

/// Evento del calendario escolar. Sin classroomId ni educationLevel es para todo el colegio.
model SchoolEvent {
  id                String          @id @default(uuid())
  schoolId          String
  title             String
  description       String?         @db.Text
  type              SchoolEventType @default(OTHER)
  startDate         DateTime        @db.Date
  endDate           DateTime?       @db.Date
  startTime         String? // 'HH:mm'; sin hora = todo el día
  endTime           String?
  location          String?
  classroomId       String?
  educationLevel    EducationLevel?
  visibleToFamilies Boolean         @default(true)
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])

  @@index([schoolId, startDate])
}

/// Jornada escolar por nivel (horas pedagógicas y recreos) que usa el generador automático de horarios.
model TimetableTemplate {
  id             String         @id @default(uuid())
  schoolId       String
  academicYearId String
  educationLevel EducationLevel
  days           Int[]          @default([1, 2, 3, 4, 5])
  slots          Json // Array<{ start: 'HH:mm', end: 'HH:mm', kind: 'CLASS' | 'BREAK', label?: string }>
  updatedAt      DateTime       @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, educationLevel])
}

/// Horas en que un docente NO puede dictar (p. ej. docentes por horas que trabajan en otro colegio).
model TeacherAvailability {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  teacherId      String
  unavailable    String[] @default([]) // 'día|HH:mm|HH:mm', p. ej. '2|08:00|09:30'
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, teacherId])
}

// ==========================================
// Experiencia de la familia (Fase 4)
// ==========================================

enum PaymentReportStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pago que la familia reporta con su voucher (Yape, Plin, transferencia o depósito) y que
/// tesorería valida. Al aprobarlo se registra la transacción y el recibo interno.
model PaymentReport {
  id              String              @id @default(uuid())
  schoolId        String
  obligationId    String
  reportedById    String
  amount          Decimal             @db.Decimal(10, 2)
  method          String // YAPE | PLIN | BANK_TRANSFER | DEPOSIT
  operationNumber String
  paidOn          DateTime            @db.Date
  voucherFileUrl  String?
  note            String?
  status          PaymentReportStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  transactionId   String?             @unique
  createdAt       DateTime            @default(now())

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  obligation  PaymentObligation   @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  reportedBy  User                @relation("PaymentReportReporter", fields: [reportedById], references: [id])
  reviewedBy  User?               @relation("PaymentReportReviewer", fields: [reviewedById], references: [id])
  transaction PaymentTransaction? @relation(fields: [transactionId], references: [id])

  @@index([schoolId, status, createdAt])
  @@index([obligationId])
}

// ==========================================
// Inteligencia para la Dirección (Fase 5)
// ==========================================

/// Intervención del plan de tutoría (entrevista, derivación, compromiso o seguimiento) sobre un
/// estudiante. Información reservada: solo la ven la Dirección, el tutor del aula y quien la registró.
model TutoringIntervention {
  id           String    @id @default(uuid())
  schoolId     String
  enrollmentId String
  authorId     String
  type         String // ENTREVISTA_ESTUDIANTE | ENTREVISTA_FAMILIA | DERIVACION | COMPROMISO | SEGUIMIENTO | OTRO
  date         DateTime  @db.Date
  notes        String    @db.Text
  agreements   String?   @db.Text
  followUpDate DateTime? @db.Date
  status       String    @default("OPEN") // OPEN | CLOSED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id])

  @@index([schoolId, enrollmentId, date])
  @@index([schoolId, status, followUpDate])
}

// ==========================================
// Herramientas del docente (Fase 6)
// ==========================================

/// Recurso que un docente comparte con sus colegas del colegio (sesiones, fichas, evaluaciones, guías).
model SharedResource {
  id             String          @id @default(uuid())
  schoolId       String
  authorId       String
  title          String
  description    String?         @db.Text
  kind           String // SESION | FICHA | EVALUACION | GUIA | PRESENTACION | OTRO
  areaName       String?
  educationLevel EducationLevel?
  grade          Int?
  fileUrl        String?
  fileName       String?
  link           String?
  tags           String[]        @default([])
  downloads      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([schoolId, createdAt])
}

/// Rúbrica reutilizable: criterios con un descriptor por nivel de logro (AD, A, B, C).
model Rubric {
  id             String          @id @default(uuid())
  schoolId       String
  authorId       String
  title          String
  description    String?         @db.Text
  areaName       String?
  educationLevel EducationLevel?
  criteria       Json // Array<{ name: string; levels: { AD: string; A: string; B: string; C: string } }>
  isShared       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([schoolId, createdAt])
}

// ============================================================================
// FASE 7: ADMISIÓN, RATIFICACIÓN, TRÁMITES Y LIBRO DE RECLAMACIONES
// ============================================================================
enum AdmissionStatus {
  NEW
  INTERVIEW
  ADMITTED
  ENROLLED
  REJECTED
  WITHDRAWN
}

model AdmissionApplication {
  id                      String          @id @default(uuid())
  schoolId                String
  status                  AdmissionStatus @default(NEW)
  targetYear              Int
  educationLevel          EducationLevel
  grade                   Int
  studentFirstNames       String
  studentLastNamePaternal String
  studentLastNameMaternal String?
  studentDocumentType     DocumentType    @default(DNI)
  studentDocumentId       String
  studentBirthDate        DateTime        @db.Date
  studentGender           Gender
  previousSchool          String?
  guardianFirstName       String
  guardianLastNames       String
  guardianDocumentId      String?
  guardianRelation        String
  guardianPhone           String
  guardianEmail           String?
  familyNotes             String?         @db.Text
  staffNotes              String?         @db.Text
  interviewAt             DateTime?
  consentAt               DateTime // Aceptación del tratamiento de datos (Ley 29733)
  ipAddress               String?
  studentId               String? // Alumno creado al convertir
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([schoolId, studentDocumentId])
}

enum RatificationDecision {
  CONFIRMED
  DECLINED
}

model EnrollmentRatification {
  id           String               @id @default(uuid())
  schoolId     String
  studentId    String
  targetYear   Int
  decision     RatificationDecision
  comment      String?              @db.Text
  ratifiedById String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ratifiedBy User    @relation(fields: [ratifiedById], references: [id])

  @@unique([studentId, targetYear])
  @@index([schoolId, targetYear])
}

enum DocumentRequestType {
  CONSTANCIA_ESTUDIOS
  CONSTANCIA_MATRICULA
  CONSTANCIA_CONDUCTA
  CONSTANCIA_NO_ADEUDO
  CERTIFICADO_ESTUDIOS
  LIBRETA_NOTAS
  OTRO
}

enum DocumentRequestStatus {
  REQUESTED
  IN_PROCESS
  READY
  DELIVERED
  REJECTED
}

model DocumentRequest {
  id            String                @id @default(uuid())
  schoolId      String
  studentId     String
  requestedById String
  type          DocumentRequestType
  purpose       String?
  copies        Int                   @default(1)
  status        DocumentRequestStatus @default(REQUESTED)
  debtHold      Boolean               @default(false) // Certificado retenido por deuda (único caso permitido, Ley 27665)
  staffNote     String?               @db.Text
  fileUrl       String? // Documento digital listo (/api/files/<id>)
  handledById   String?
  readyAt       DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("DocumentRequestRequester", fields: [requestedById], references: [id])
  handledBy   User?   @relation("DocumentRequestHandler", fields: [handledById], references: [id])

  @@index([schoolId, status])
  @@index([studentId])
}

enum ComplaintKind {
  RECLAMO
  QUEJA
}

enum ComplaintStatus {
  OPEN
  ANSWERED
}

model Complaint {
  id              String          @id @default(uuid())
  schoolId        String
  code            String // RCL-2026-000001
  kind            ComplaintKind
  status          ComplaintStatus @default(OPEN)
  consumerName    String
  consumerDocType String
  consumerDocId   String
  consumerAddress String?
  consumerPhone   String?
  consumerEmail   String
  isMinor         Boolean         @default(false)
  guardianName    String?
  itemType        String          @default("SERVICIO") // PRODUCTO | SERVICIO
  itemDescription String
  amount          String?
  detail          String          @db.Text
  request         String          @db.Text
  dueDate         DateTime        @db.Date // Plazo legal de respuesta (15 días hábiles)
  response        String?         @db.Text
  respondedAt     DateTime?
  respondedById   String?
  ipAddress       String?
  createdAt       DateTime        @default(now())

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  respondedBy User?  @relation(fields: [respondedById], references: [id])

  @@unique([schoolId, code])
  @@index([schoolId, status])
}
